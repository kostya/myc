STRUCT :Pair
  TYPE :i32
  TYPE :i32
ENDSTRUCT

FUNC :change
  ARGS
    TYPE :Pair
  RETURN
    TYPE :Pair
  BODY
    PARAM 0
    LOCAL :copy :Pair
    STORE
    PUSH 99
    LOCAL :copy
    FIELD 0
    STORE
    LOCAL :copy
    RET
ENDFUNC

FUNC :main
  BODY
    PUSH 8
    PUSH 7
    CREATE :Pair
    LOCAL :original :Pair
    STORE
    LOCAL :original
    CALL :change
    LOCAL :changed :Pair
    STORE
    LOCAL :changed
    FIELD 0
    INSPECT
    LOCAL :original
    FIELD 0
    INSPECT
ENDFUNC
