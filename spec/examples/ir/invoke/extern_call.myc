FUNC :create
  RETURN
    TYPE :i32
ENDFUNC

FUNC :reg
  ARGS
    TYPE :fn<i32>
  RETURN
    TYPE :i32
  BODY
    PARAM 0
    INVOKE
    RET
ENDFUNC

FUNC :main
  RETURN
    TYPE :i32
  BODY
    ADDR :create
    LOCAL :x :fn<i32>
    STORE
    LOCAL :x
    CALL :reg
    INSPECT
    PUSH 0
    RET
ENDFUNC

