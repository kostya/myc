    INSPECT
    PUSH "Quote: \"test\""
    INSPECT
    PUSH "Hex bytes: Hello"
    INSPECT
    PUSH "Hex bytes: ABC"
    INSPECT
    PUSH "Hex braces: HI"
    INSPECT
    PUSH "Mixed: Hello\nWorld!"
    INSPECT
    PUSH "Octal: ABC"
    INSPECT
    PUSH "Octal braces: DE"
    INSPECT
    PUSH "Octal space:  Hello!"
    INSPECT
    PUSH "Octal two: HI"
    INSPECT
    PUSH "Unicode: Привет"
    INSPECT
    PUSH "Unicode short: Hello"
    INSPECT
    PUSH "Unicode omega: Ω"
    INSPECT
    PUSH "Unicode arrow: →"
    INSPECT
    PUSH "Unicode braces: ABC"
    INSPECT
    PUSH "Emoji: 😀"
    INSPECT
    PUSH "Chinese: 你好"
    INSPECT
    PUSH "Complex: 👋 Hello 👋"
    INSPECT
    PUSH "Clef: 𝄞"
    INSPECT
    PUSH "MAX: 􏿿"
    INSPECT
    PUSH "Mixed: Hello! World?\nNew line\n"
    INSPECT
