FUNC :main
  BODY
    PUSH 3
    ALLOCA :i32
    LOCAL :x :ptr<i32>
    STORE
    PUSH 1
    LOCAL :x
    DEREF
    STORE
    PUSH 2
    PUSH 1
    LOCAL :x
    BINARY :add
    DEREF
    STORE
    PUSH 3
    PUSH 2
    LOCAL :x
    BINARY :add
    DEREF
    STORE
    LOCAL :x
    DEREF
    INSPECT
    PUSH 1
    LOCAL :x
    BINARY :add
    DEREF
    INSPECT
    PUSH 2
    LOCAL :x
    BINARY :add
    DEREF
    INSPECT
ENDFUNC

