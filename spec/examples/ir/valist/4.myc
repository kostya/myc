FUNC :add
  ARGS
    TYPE :i32
    TYPE :ptr<valist>
  RETURN
    TYPE :i32
  BODY
    PUSH 0
    LOCAL :sum :i32
    STORE
    PUSH 0
    LOCAL :__s0_i :i32
    STORE
    LOOP
      COND
        PARAM 0
        LOCAL :__s0_i
        BINARY :less
      BODY
        PARAM 1
        DEREF
        VA :arg :i32
        LOCAL :sum
        BINARY :add
        LOCAL :sum
        STORE
      STEP
        PUSH 1 :i32
        LOCAL :__s0_i
        BINARY :add
        LOCAL :__s0_i
        STORE
    ENDLOOP
    LOCAL :sum
    RET
ENDFUNC

FUNC :sum
  ARGS
    TYPE :i32
  RETURN
    TYPE :i32
  ATTRIBUTES
    ATTR :vaarg
  BODY
    PARAM 0
    LOCAL :__s0_ap :valist
    VA :start
    LOCAL :__s0_ap
    ADDR
    PARAM 0
    CALL :add
    SLOT :res
    LOCAL :__s0_ap
    VA :end
    SLOT :res
    RET
ENDFUNC

FUNC :main
  RETURN
    TYPE :i32
  BODY
    PUSH 30
    PUSH 20
    PUSH 10
    PUSH 3
    CALL :sum 3
    INSPECT
    PUSH 0
    RET
ENDFUNC

