FUNC :bla
  ARGS
    TYPE :i32
  RETURN
    TYPE :i32
  BODY
    PUSH 1
    PARAM 0
    BINARY :add
    RET
ENDFUNC

FUNC :main
  RETURN
    TYPE :i32
  BODY
    ADDR :bla
    AS :u64
    LOCAL :__s0_tmp :u64
    STORE
    LOCAL :__s0_tmp
    AS "fn<i32, i32>"
    LOCAL :__s0_f "fn<i32, i32>"
    STORE
    PUSH 25
    LOCAL :__s0_f
    INVOKE
    PUSH "tmp = %d\n"
    PRINTF 1
    PUSH 0
    RET
ENDFUNC