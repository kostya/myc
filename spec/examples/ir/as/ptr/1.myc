FUNC :bla
  ARGS
    TYPE :i32
  RETURN
    TYPE :i32
  BODY
    PUSH 1
    PARAM 0
    BINARY :add
    RET
ENDFUNC

FUNC :main
  RETURN
    TYPE :i32
  BODY
    PUSH 0
    AS :ptr<void>
    AS "fn<i32, i32>"
    LOCAL :__s0_tmp "fn<i32, i32>"
    STORE
    PUSH 0 "fn<i32, i32>"
    LOCAL :__s0_tmp
    BINARY :not_eq
    IF
      THEN
        PUSH "no tmp\n"
        PRINTF 0
    ENDIF
    ADDR :bla
    LOCAL :__s0_tmp
    STORE
    PUSH 0 "fn<i32, i32>"
    LOCAL :__s0_tmp
    BINARY :not_eq
    IF
      THEN
        PUSH 25
        LOCAL :__s0_tmp
        INVOKE
        PUSH "tmp = %d\n"
        PRINTF 1
    ENDIF
    ADDR :bla
    AS :ptr<void>
    LOCAL :__s2_ptr :ptr<void>
    STORE
    LOCAL :__s2_ptr
    AS "fn<i32, i32>"
    LOCAL :__s0_tmp
    STORE
    PUSH 0 "fn<i32, i32>"
    LOCAL :__s0_tmp
    BINARY :not_eq
    IF
      THEN
        PUSH 26
        LOCAL :__s0_tmp
        INVOKE
        PUSH "tmp2 = %d\n"
        PRINTF 1
    ENDIF
    PUSH 0
    RET
ENDFUNC