FUNC :add
  ARGS
    TYPE :i32
    TYPE :i32
  RETURN
    TYPE :i32
  BODY
    PARAM 1
    SLOT :a
    PARAM 0
    SLOT :b
    SLOT :a
    SLOT :b
    BINARY :add
    RET
ENDFUNC

FUNC :test_inline
  BODY
    PUSH 10
    PUSH 5
    CALL :add
    INSPECT
ENDFUNC

FUNC :main BODY
  CALL :test_inline
ENDFUNC