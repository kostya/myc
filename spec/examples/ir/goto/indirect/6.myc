FUNC :main
  BODY
    PUSH 0
    LOCAL :i :i32
    STORE
    LOOP
      COND
        PUSH 10
        LOCAL :i
        BINARY :less
      BODY
        PUSH 3
        LOCAL :i
        BINARY :rem
        PUSH 0
        BINARY :eq
        IF
          THEN
            ADDR :op0
            LOCAL :label :indirect
            STORE
          ELSE
            PUSH 3
            LOCAL :i
            BINARY :rem
            PUSH 1
            BINARY :eq
            IF
              THEN
                ADDR :op1
                LOCAL :label :indirect
                STORE
              ELSE
                ADDR :op2
                LOCAL :label :indirect
                STORE
            ENDIF
        ENDIF
        LOCAL :label
        GOTO :op0 :op1 :op2
        LABEL :op0
        PUSH :op0
        INSPECT
        GOTO :cont
        LABEL :op1
        PUSH :op1
        INSPECT
        GOTO :cont
        LABEL :op2
        PUSH :op2
        INSPECT
        LABEL :cont
      STEP
        PUSH 1
        LOCAL :i
        BINARY :add
        LOCAL :i
        STORE
    ENDLOOP
ENDFUNC

