FUNC :f
  ARGS
    TYPE :bool
  RETURN
    TYPE :i32
  BODY
    PARAM 0
    IF
      THEN
        PUSH 1
        RET
        PUSH 1
        INSPECT
        LOOP
          COND
            PUSH false
          BODY
          STEP
        ENDLOOP
        CALL :f
        INSPECT
    ENDIF
    PUSH 2
    RET
ENDFUNC

FUNC :main
  BODY
    PUSH false
    CALL :f
    INSPECT
    PUSH true
    CALL :f
    INSPECT
ENDFUNC

