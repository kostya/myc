FUNC :main
  BODY
    PUSH 0
    LOCAL :x :i32
    STORE
    LOOP
      COND
        PUSH 11
        LOCAL :x
        BINARY :less
      BODY
        LOCAL :x
        CALL :EnumTest_create
        LOCAL :var :EnumTest
        STORE
        LOCAL :var
        INSPECT
      STEP
        PUSH 1
        LOCAL :x
        BINARY :add
        LOCAL :x
        STORE
    ENDLOOP
ENDFUNC

